# Copy to .env and fill in. Never commit .env.
PORT=8787
# URL other machines use to reach this service (audio links are built from it). Use your LAN IP for the demo.
PUBLIC_URL=http://localhost:8787

# mock = built-in stand-in for Aditya's actors; terse = real actors via ./generated (see src/actors/terse.ts)
BACKEND=mock
# Terse (durable-actors) client settings. Defaults fit `bunx durable-actors dev` on this machine:
# 127.0.0.1:7100, project "local", no secret. Set these only for a runtime elsewhere.
# The URL is an origin only: no path after the port.
# DURABLE_ACTORS_CONTROL_PLANE_URL=http://<aditya-ip>:7100
# DURABLE_ACTORS_PROJECT_ID=local
# DURABLE_ACTORS_SECRET=

OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE_AGENT=coral
TTS_VOICE_TWIN=sage

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=voice
DEMO_PASSWORD=sanjeevni-demo

# Director "Restart backend" button. Rehearse with Aditya 3 times. Needs bun on the PATH of the shell running npm start.
# RESTART_CMD=ACTORS_DIR=/path/to/aditya/actors ./scripts/restart-backend.sh
RESTART_CMD=
# Optional shared secret Aditya sends as X-Ingest-Token on POST /events/ingest
INGEST_TOKEN=
HANDOFF_PREP_WAIT_MS=4000
