{
  "name": "sanjeevni-voice",
  "private": true,
  "type": "module",
  "description": "Sanjeevni voice service + Supabase + integration gateway (Shresth)",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "check-voice": "node --env-file-if-exists=.env scripts/check-voice.ts",
    "seed:auth": "node --env-file-if-exists=.env scripts/seed-auth.ts",
    "smoke": "node scripts/smoke.ts",
    "samples": "node scripts/samples.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
